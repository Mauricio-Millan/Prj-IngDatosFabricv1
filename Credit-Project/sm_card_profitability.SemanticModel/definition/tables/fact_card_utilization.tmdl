table fact_card_utilization
	lineageTag: c46e1cf0-4f27-4439-9f01-8ae39f8e6198
	sourceLineageTag: [dbo].[fact_card_utilization]

	measure 'Total Monthly Spend' = SUM(fact_card_utilization[monthly_spend])
		lineageTag: 6019b81b-8d52-4cad-bf4d-a9957a903a77

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Credit Limit' = ```
			
			    SUMX(VALUES(dim_card[card_id]), CALCULATE(MAX(dim_card[credit_limit])))
			```
		lineageTag: 2f829aef-f066-4574-898e-e6c3b0fab724

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Interchange Revenue Proxy' = ```
			
			    SUM(fact_card_utilization[interchange_revenue_proxy])
			```
		lineageTag: be6e190d-605f-4f06-af6a-e58408aa3ad3

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cards Optimal Zone' = ```
			
			    CALCULATE(DISTINCTCOUNT(fact_card_utilization[card_id]),
			        fact_card_utilization[utilization_band] = "Optimal (30-70%)")
			
			```
		formatString: 0
		lineageTag: c87cb5ed-3f66-4d00-8bd9-ca19c430e706

		changedProperty = Name

	measure 'Cards Upgrade Candidates' = ```
			
			    CALCULATE(DISTINCTCOUNT(fact_card_utilization[card_id]),
			        fact_card_utilization[upgrade_candidate] = TRUE())
			```
		formatString: 0
		lineageTag: 6ee6dc2d-fed0-48ac-8dea-54159d93e024

		changedProperty = Name

	measure 'Avg Utilization %' =
			
			CALCULATE(
			    AVERAGE(fact_card_utilization[utilization_ratio]),
			    fact_card_utilization[credit_limit] > 500,
			    fact_card_utilization[utilization_ratio] <= 3
			)
		formatString: Percent
		lineageTag: d3621ca0-4ea6-4805-b73b-1d27b02b8614

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Portfolio Optimal %' = ```
			
			    DIVIDE([Cards Optimal Zone],
			        DISTINCTCOUNT(fact_card_utilization[card_id]))
			```
		formatString: Percent
		lineageTag: 8d48f6ab-39cf-4e38-a4f7-11baeb79ff62

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Return on Limit' = ```
			
			    DIVIDE([Interchange Revenue Proxy], [Total Credit Limit])
			```
		formatString: Percent
		lineageTag: 07808fed-3887-4eb5-b742-009eeaed1572

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'MoM Utilization Change pp' =
			
			VAR CurrentMonth = SELECTEDVALUE(dim_date_month[month_key])
			VAR PriorMonthKey =
			    IF(
			        MOD(CurrentMonth, 100) = 1,
			        CurrentMonth - 100 + 11,
			        CurrentMonth - 1
			    )
			VAR PriorUtil =
			    CALCULATE(
			        [Avg Utilization %],
			        ALL(dim_date_month),
			        dim_date_month[month_key] = PriorMonthKey
			    )
			RETURN
			    [Avg Utilization %] - PriorUtil
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: fb12bd69-8857-4ad3-b226-653c4d122d69

		changedProperty = Name

		changedProperty = FormatString

	measure 'Cards Extreme Utilization' =
			
			CALCULATE(
			    DISTINCTCOUNT(fact_card_utilization[card_id]),
			    fact_card_utilization[utilization_ratio] > 3
			)
		formatString: 0
		lineageTag: 4abc1a39-fe76-496c-a899-d47a79317b1c

		changedProperty = Name

	measure 'Extreme Cases Exposure $' =
			
			CALCULATE(
			    SUM(fact_card_utilization[monthly_spend]),
			    fact_card_utilization[utilization_ratio] > 3
			)
		lineageTag: b77f3862-d172-4476-950b-0ca763c2fa31

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median Utilization %' =
			
			MEDIANX(
			    FILTER(
			        fact_card_utilization,
			        fact_card_utilization[credit_limit] > 500
			    ),
			    fact_card_utilization[utilization_ratio]
			)
		lineageTag: 7831f4d0-145b-46d6-bc84-dc46a8873763

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cards Count' = DISTINCTCOUNT(fact_card_utilization[card_id])
		formatString: 0
		lineageTag: 75626d10-24b0-43ab-887f-a29d5f7ebbcc

	measure 'Target Optimal %' = 0.65
		formatString: Percent
		lineageTag: bcb811a6-2118-4579-a705-7efdf9baeab8

	measure 'Gauge Max' = 1
		formatString: 0
		lineageTag: 36e3ac15-fd1c-4674-93ab-7c0df581d278

	measure 'Dormant Activation Potential $' = ```
			
			    SUMX(
			        FILTER(
			            fact_card_utilization,
			            fact_card_utilization[utilization_ratio] < 0.10
			        ),
			        fact_card_utilization[credit_limit] * 0.30 * 0.0235
			    )
			```
		lineageTag: 370bec37-ce5b-4f5a-af76-c2a24034b0d5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue per Active Card' = ```
			
			    DIVIDE(
			        [Interchange Revenue Proxy],
			        CALCULATE(
			            DISTINCTCOUNT(fact_card_utilization[card_id]),
			            fact_card_utilization[monthly_spend] > 0
			        )
			    )
			```
		lineageTag: 44ecc879-0d5f-4cc3-9867-5566ab76687c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

